# Values for docker-compose.yml. Copy this file to .env (git ignores .env) and fill in the empty ones.
# A random value:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Password of the `sa` login of the SQL Server container. At least 8 characters with upper and lower case letters and
# a digit; no ";" and no "$" (it goes into a connection string and through compose's variable substitution).
# It is applied when the data volume is first created. To change it later: docker compose down -v (this erases the data).
MSSQL_SA_PASSWORD=

# Shared by the API and the math service. 32 characters or more.
MATH_API_KEY=

# Signs the API's own access tokens. 32 characters or more.
JWT_SECRET=

# The OAuth client ID (type Web application) of the Google Cloud project. Public by design; it is the same one the
# client has in VITE_GOOGLE_CLIENT_ID. Sign-in works only from the origins that client allows (http://localhost:3000,
# http://localhost and the deployed client), so run the client on one of those.
GOOGLE_CLIENT_ID=465641334832-2sh1dail983c2vi10qek7up0bo4pva10.apps.googleusercontent.com

# The Google account that becomes an admin when it signs in (leave empty for none). Sign out and in again after changing it.
ADMIN_EMAIL=

# Optional; the defaults are shown.
# JWT_ISSUER=portfolio-manager-local
# CLIENT_ORIGIN=http://localhost:3000
# API_PORT=5050
# SQL_PORT=14330
# RISK_FREE_RATE=0
