VITE_API_URL=https://portfoliomanagerapi.azurewebsites.net/api/
# OAuth client ID (type "Web application") from Google Cloud. Public by design, but baked in at build time, so
# rebuild after changing it. Empty = the sign-in page says Google sign-in is not configured.
# For local work put your own value in .env.local, which git ignores.
VITE_GOOGLE_CLIENT_ID=465641334832-2sh1dail983c2vi10qek7up0bo4pva10.apps.googleusercontent.com
