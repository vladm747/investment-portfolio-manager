<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <!-- The auth services use ASP.NET Core Identity (SignInManager) and the JWT types. The reference used to come
           in through PortfolioManager.Common, which has no business depending on a web framework. -->
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
      <!-- Validates the ID token that "Sign in with Google" gives the browser. -->
      <PackageReference Include="Google.Apis.Auth" Version="1.78.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\PortfolioManager.Common\PortfolioManager.Common.csproj" />
      <ProjectReference Include="..\PortfolioManager.DAL\PortfolioManager.DAL.csproj" />
      <ProjectReference Include="..\PortfolioManager.MathModule.Client\PortfolioManager.MathModule.Client.csproj" />
    </ItemGroup>

</Project>
